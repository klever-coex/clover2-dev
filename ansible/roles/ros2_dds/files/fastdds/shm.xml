<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://raw.githubusercontent.com/eProsima/Fast-DDS/refs/tags/v2.14.6/resources/xsd/fastRTPS_profiles.xsd"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <transport_descriptors>

        <transport_descriptor>
            <transport_id>DEFAULT_SHM_TRANSPORT</transport_id>
            <type>SHM</type>
            <segment_size>134217728</segment_size>
            <port_queue_capacity>64</port_queue_capacity>
            <healthy_check_timeout_ms>1000</healthy_check_timeout_ms>
        </transport_descriptor>

        <!-- Fallback Transport -->
        <transport_descriptor>
            <transport_id>DEFAULT_UDP_TRANSPORT</transport_id>
            <type>UDPv4</type>
            <sendBufferSize>1048576</sendBufferSize>
            <receiveBufferSize>1048576</receiveBufferSize>
            <non_blocking_send>true</non_blocking_send>
            <interfaceWhiteList>
                <address>127.0.0.1</address>
            </interfaceWhiteList>
        </transport_descriptor>

    </transport_descriptors>

    <participant profile_name="default_participant_profile" is_default_profile="true">
        <rtps>
            <name>Default Participant Profile</name>

            <userTransports>
                <transport_id>DEFAULT_SHM_TRANSPORT</transport_id>
                <transport_id>DEFAULT_UDP_TRANSPORT</transport_id>
            </userTransports>

            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>

</profiles>
