# Managed by ansible (clover2.dev.ros2_dds)
export RMW_IMPLEMENTATION={{ ros2_dds_implementations[ros2_dds_rmw].rmw_implementation }}
{% if ros2_dds_rmw == 'cyclonedds' %}
export CYCLONEDDS_URI=file://{{ ros2_dds_config_dir }}/cyclonedds/{{ ros2_dds_profile }}.xml
{% else %}
export FASTRTPS_DEFAULT_PROFILES_FILE={{ ros2_dds_config_dir }}/fastdds/{{ ros2_dds_profile }}.xml
export FASTDDS_DEFAULT_PROFILES_FILE={{ ros2_dds_config_dir }}/fastdds/{{ ros2_dds_profile }}.xml
{% endif %}
{% if ros2_dds_ros_domain_id is not none %}
export ROS_DOMAIN_ID={{ ros2_dds_ros_domain_id }}
{% endif %}
